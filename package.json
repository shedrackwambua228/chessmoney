{
  "name": "chessmoney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-engine.mjs",
    "predev": "node scripts/prepare-engine.mjs",
    "prebuild": "node scripts/prepare-engine.mjs",
    "predev:all": "node scripts/prepare-engine.mjs",
    "dev": "vite",
    "api": "npm --prefix backend run build && npm --prefix backend start",
    "dev:all": "npm run api:build && node scripts/dev.mjs",
    "test:api": "npm --prefix backend test",
    "api:nest": "npm --prefix backend run start:dev",
    "api:build": "npm --prefix backend run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "chess.js": "^1.4.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stockfish": "18.0.8",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
